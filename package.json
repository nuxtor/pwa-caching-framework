{
  "name": "pwa-caching-framework",
  "version": "1.0.0",
  "description": "PWA Performance Optimization Framework - MSc Dissertation Project",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "vitest",
    "test:perf": "playwright test tests/performanceTest.ts",
    "test:perf:headed": "playwright test tests/performanceTest.ts --headed",
    "lighthouse": "lighthouse http://localhost:5173 --output=json --output-path=./reports/lighthouse.json",
    "analyze": "node scripts/analyzeResults.js"
  },
  "dependencies": {
    "idb": "^7.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "lighthouse": "^11.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0",
    "vitest": "^1.0.0"
  }
}
